{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "KeyProvider.Worker": "Debug",
      "KeyProvider.KeyRotation": "Debug"
    }
  },
  "KeyRotation": {
    "Lifespan": "00:15:00"
  },
  "Worker": {
    "Expression": "*/2 * * * *",
    "MaxCheckDelay": "00:00:30",
    "FailureRetryDelay": "00:00:20"
  },
  "RotationRetry": {
    "MaxRetryAttempts": 3,
    "BaseDelay": "00:00:01",
    "MaxDelay": "00:00:05",
    "AttemptTimeout": "00:00:10"
  }
}
