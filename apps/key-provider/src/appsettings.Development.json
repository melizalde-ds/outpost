{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "KeyProvider.KeyRotation": "Debug"
    }
  },
  "KeyRotation": {
    "Lifespan": "00:15:00",
    "Schedule": {
      "Expression": "*/2 * * * *",
      "MaxCheckDelay": "00:00:30",
      "FailureRetryDelay": "00:00:20"
    },
    "Retry": {
      "MaxRetryAttempts": 3,
      "BaseDelay": "00:00:01",
      "MaxDelay": "00:00:05",
      "AttemptTimeout": "00:00:10"
    }
  }
}
