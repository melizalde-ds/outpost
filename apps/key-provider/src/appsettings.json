{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "KeyProvider": "",
    "DataProtection": ""
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    }
  },
  "KeyRotation": {
    "Lifespan": "1.00:00:00"
  },
  "Worker": {
    "Expression": "0 */8 * * *",
    "MaxCheckDelay": "00:05:00",
    "FailureRetryDelay": "00:05:00"
  },
  "RotationRetry": {
    "MaxRetryAttempts": 3,
    "BaseDelay": "00:00:02",
    "MaxDelay": "00:01:00",
    "AttemptTimeout": "00:00:30"
  }
}
