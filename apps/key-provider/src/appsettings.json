{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "KeyProvider": "",
    "DataProtection": ""
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "Signing": {
    "Issuer": "Outpost",
    "TokenLifetime": "00:05:00",
    "PublishDelay": "00:03:00"
  },
  "KeyRotation": {
    "Lifespan": "1.00:00:00",
    "Schedule": {
      "Expression": "0 */8 * * *",
      "MaxCheckDelay": "00:05:00",
      "FailureRetryDelay": "00:05:00"
    },
    "Retry": {
      "MaxRetryAttempts": 3,
      "BaseDelay": "00:00:02",
      "MaxDelay": "00:01:00",
      "AttemptTimeout": "00:00:30"
    }
  }
}
