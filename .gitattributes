# Normalize line endings to LF (SQL init scripts are mounted into Postgres).
* text=auto eol=lf

# Generated by `buf generate` (see buf.gen.yaml).
*_pb2*.py   linguist-generated=true
*_pb2*.pyi  linguist-generated=true

# Machine-written; collapse in diffs.
Cargo.lock       linguist-generated=true
uv.lock          linguist-generated=true
**/.sqlx/*.json  linguist-generated=true

# Show enclosing function in diff hunk headers.
*.rs diff=rust
*.py diff=python
